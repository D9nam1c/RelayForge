{
  "realm": "relayforge",
  "enabled": true,
  "displayName": "RelayForge local demo",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {"realm": [
    {"name": "TENANT_ADMIN"}, {"name": "TENANT_OPERATOR"},
    {"name": "PRODUCER"}, {"name": "PLATFORM_ADMIN"}
  ]},
  "clientScopes": [{
    "name": "events:write",
    "protocol": "openid-connect",
    "attributes": {"include.in.token.scope": "true"}
  }],
  "clients": [
    {
      "clientId": "relayforge-cli", "publicClient": true, "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true, "redirectUris": ["http://localhost:*"], "webOrigins": ["http://localhost:*"],
      "protocolMappers": [{
        "name": "tenant-id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
        "config": {"user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String",
          "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}
      }]
    },
    {
      "clientId": "acme-producer", "secret": "__ACME_PRODUCER_SECRET__", "publicClient": false,
      "serviceAccountsEnabled": true, "standardFlowEnabled": false, "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["events:write", "roles"],
      "protocolMappers": [{
        "name": "tenant-id", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
        "config": {"claim.name": "tenant_id", "claim.value": "11111111-1111-1111-1111-111111111111",
          "jsonType.label": "String", "access.token.claim": "true"}
      }]
    },
    {
      "clientId": "globex-producer", "secret": "__GLOBEX_PRODUCER_SECRET__", "publicClient": false,
      "serviceAccountsEnabled": true, "standardFlowEnabled": false, "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["events:write", "roles"],
      "protocolMappers": [{
        "name": "tenant-id", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
        "config": {"claim.name": "tenant_id", "claim.value": "22222222-2222-2222-2222-222222222222",
          "jsonType.label": "String", "access.token.claim": "true"}
      }]
    }
  ],
  "users": [
    {"username": "acme-admin", "enabled": true, "attributes": {"tenant_id": ["11111111-1111-1111-1111-111111111111"]},
      "realmRoles": ["TENANT_ADMIN"], "credentials": [{"type": "password", "value": "__ACME_ADMIN_PASSWORD__", "temporary": false}]},
    {"username": "acme-operator", "enabled": true, "attributes": {"tenant_id": ["11111111-1111-1111-1111-111111111111"]},
      "realmRoles": ["TENANT_OPERATOR"], "credentials": [{"type": "password", "value": "__ACME_OPERATOR_PASSWORD__", "temporary": false}]},
    {"username": "globex-admin", "enabled": true, "attributes": {"tenant_id": ["22222222-2222-2222-2222-222222222222"]},
      "realmRoles": ["TENANT_ADMIN"], "credentials": [{"type": "password", "value": "__GLOBEX_ADMIN_PASSWORD__", "temporary": false}]}
  ]
}
